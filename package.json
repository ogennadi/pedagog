{
  "name": "pedagog",
  "version": "1.0.0",
  "description": "A single-file, pedagogical UCI chess engine in TypeScript (Bun or browser)",
  "main": "engine.ts",
  "scripts": {
    "start": "bun engine.ts",
    "bench": "bun engine.ts bench",
    "perft": "bun engine.ts perft",
    "check": "tsc --noEmit --strict --target ES2022 --lib ES2022 --erasableSyntaxOnly --noUnusedLocals --noUnusedParameters engine.ts",
    "web": "bun src/tools/serve.js",
    "build": "bun src/tools/build.js",
    "test": "bun test src/tests/rules.test.js src/tests/book.test.js",
    "match": "bun src/tools/match.js",
    "elo": "bun src/tools/elo.js",
    "diff": "bun src/tools/uci-diff.js"
  },
  "private": true,
  "devDependencies": {
    "typescript": "5"
  }
}
